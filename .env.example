# Copy to .env.local for local use. Names and placeholders only; never commit real values.

# mock (default, no credentials needed), ryanair (live, keyless) or ignav (live, needs a key)
FLIGHT_PROVIDER=mock

# Required only when FLIGHT_PROVIDER=ignav. Without it the app falls back to mock and says so.
IGNAV_API_KEY=your-ignav-api-key

# Search engine tuning. Commented lines show the generic defaults; setting one overrides the
# provider-specific default, so leave them commented unless you mean it.
# Default 60 (90 for ryanair).
# MAX_PROVIDER_CALLS=60
CACHE_TTL_SECONDS=1200
PROVIDER_TIMEOUT_MS=10000
PROVIDER_RETRIES=2
PROVIDER_BACKOFF_MS=400
# Default 4 (2 for ryanair).
# SEARCH_CONCURRENCY=4
# Default 3. Ignav's fare calendar prices every day, so it ignores this.
# MAX_DATES_PER_LEG=3
# Default unlimited for ryanair, 15 for mock, 12 for ignav (a one-time 1,000-request free allowance, then $2.00 per 1,000 requests).
# MAX_AIRPORTS_PER_COUNTRY=12
# Combinations whose calendar-priced legs get an exact re-check. Default 0 (5 for ignav).
# VERIFY_TOP=5
