# Copy to .env.local for local use. Names and placeholders only; never commit real values.

# mock (default, no credentials needed) or amadeus
FLIGHT_PROVIDER=mock

# Required only when FLIGHT_PROVIDER=amadeus. Without them the app falls back to mock and says so.
AMADEUS_CLIENT_ID=your-amadeus-client-id
AMADEUS_CLIENT_SECRET=your-amadeus-client-secret
# Optional; defaults to the test host.
# AMADEUS_BASE_URL=https://test.api.amadeus.com

# Search engine tuning (defaults shown)
MAX_PROVIDER_CALLS=60
CACHE_TTL_SECONDS=1200
SEARCH_CONCURRENCY=4
PROVIDER_TIMEOUT_MS=10000
PROVIDER_RETRIES=2
PROVIDER_BACKOFF_MS=400
MAX_DATES_PER_LEG=3
