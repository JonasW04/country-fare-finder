# Copy to .env.local for local use. Names and placeholders only; never commit real values.

# mock (default, no credentials needed), ryanair (live, keyless) or ignav (live, needs a key)
FLIGHT_PROVIDER=mock

# Required only when FLIGHT_PROVIDER=ignav. Without it the app falls back to mock and says so.
IGNAV_API_KEY=your-ignav-api-key

# Search engine tuning (defaults shown)
MAX_PROVIDER_CALLS=60
CACHE_TTL_SECONDS=1200
# Default is 4, or 2 when FLIGHT_PROVIDER=ryanair.
SEARCH_CONCURRENCY=4
PROVIDER_TIMEOUT_MS=10000
PROVIDER_RETRIES=2
PROVIDER_BACKOFF_MS=400
MAX_DATES_PER_LEG=3
